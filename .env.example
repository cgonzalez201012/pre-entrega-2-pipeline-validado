# Copiá este archivo como ".env" y completá tus claves. NUNCA subas el .env a GitHub.

# Proveedor a usar: "anthropic" u "openai"
LLM_PROVIDER=anthropic

# Claves de API (completá al menos la del proveedor elegido)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opcionales (si los omitís se usan estos valores por defecto)
# LLM_MODEL=claude-haiku-4-5
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT_S=60
# LLM_MAX_INTENTOS=3
